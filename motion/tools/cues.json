[
 {
  "i": 1,
  "t0": 0.0,
  "t1": 3.203,
  "text": "1세대, 2세대 실손보험 갖고 계신 분들"
 },
 {
  "i": 2,
  "t0": 3.203,
  "t1": 7.307,
  "text": "\"보험사가 옛날 실손을 사드린다! 보상금을 준다!\""
 },
 {
  "i": 3,
  "t0": 7.307,
  "t1": 9.676,
  "text": "이런 뉴스 한 번쯤 들어보셨죠?"
 },
 {
  "i": 4,
  "t0": 9.676,
  "t1": 13.013,
  "text": "그래서 여러분들은 얼마에 파시려고 하셨나요?"
 },
 {
  "i": 5,
  "t0": 13.013,
  "t1": 14.514,
  "text": "5천만원? 1억?"
 },
 {
  "i": 6,
  "t0": 14.514,
  "t1": 16.683,
  "text": "여러 갑론을박이 있었는데요"
 },
 {
  "i": 7,
  "t0": 16.683,
  "t1": 18.518,
  "text": "그런데 말이죠, 그 기대"
 },
 {
  "i": 8,
  "t0": 18.518,
  "t1": 20.353,
  "text": "완전히 뒤집혔습니다"
 },
 {
  "i": 9,
  "t0": 20.353,
  "t1": 22.956,
  "text": "여러분이 기다리던 현금 보상은"
 },
 {
  "i": 10,
  "t0": 22.956,
  "t1": 24.824,
  "text": "결국 없던 일이 됐고요"
 },
 {
  "i": 11,
  "t0": 24.824,
  "t1": 28.061,
  "text": "그 자리에 전혀 다른 조건이 들어왔습니다"
 },
 {
  "i": 12,
  "t0": 28.061,
  "t1": 30.196,
  "text": "오늘 영상 끝까지 보시면"
 },
 {
  "i": 13,
  "t0": 30.196,
  "t1": 32.465,
  "text": "무엇이 어떻게 바뀌었는지,"
 },
 {
  "i": 14,
  "t0": 32.465,
  "t1": 35.602,
  "text": "바뀐 조건이 나한테 이득인지, 손해인지"
 },
 {
  "i": 15,
  "t0": 35.602,
  "t1": 39.372,
  "text": "판단 기준까지 확실하게 가져가실 수 있습니다"
 },
 {
  "i": 16,
  "t0": 39.372,
  "t1": 40.774,
  "text": "바뀐 걸 이해하려면"
 },
 {
  "i": 17,
  "t0": 40.774,
  "t1": 44.844,
  "text": "5세대 실손보험이 어떤 구조인지부터 알아야 합니다"
 },
 {
  "i": 18,
  "t0": 44.844,
  "t1": 47.247,
  "text": "먼저 큰 그림부터 잡아볼까요?"
 },
 {
  "i": 19,
  "t0": 47.247,
  "t1": 49.849,
  "text": "금융 당국이 발표한 개편 방향을"
 },
 {
  "i": 20,
  "t0": 49.849,
  "t1": 52.218,
  "text": "한 문장으로 요약하면 이겁니다"
 },
 {
  "i": 21,
  "t0": 52.218,
  "t1": 56.456,
  "text": "\"실손 제도를 오래 유지할 수 있게 손해율를 잡겠다!\""
 },
 {
  "i": 22,
  "t0": 56.456,
  "t1": 60.16,
  "text": "손해율을 잡는다는 게 우리 입장에서 무슨 뜻일까요?"
 },
 {
  "i": 23,
  "t0": 60.16,
  "t1": 63.096,
  "text": "경증으로 병원을 자주 다니시는 분들,"
 },
 {
  "i": 24,
  "t0": 63.096,
  "t1": 67.867,
  "text": "즉, 가벼운 통증으로 물리치료를 꾸준히 받으시는 이런 분들이"
 },
 {
  "i": 25,
  "t0": 67.867,
  "t1": 71.504,
  "text": "앞으로 내야 하는 병원비가 늘어난다는 뜻입니다"
 },
 {
  "i": 26,
  "t0": 71.504,
  "t1": 74.541,
  "text": "병원비 영수증을 살펴보면 두 종류가 있죠"
 },
 {
  "i": 27,
  "t0": 74.541,
  "t1": 76.643,
  "text": "건강보험이 적용되는 급여,"
 },
 {
  "i": 28,
  "t0": 76.643,
  "t1": 79.245,
  "text": "그리고 내가 전액 부담해야 하는 비급여"
 },
 {
  "i": 29,
  "t0": 79.245,
  "t1": 82.882,
  "text": "5세대 실손는 이 두 가지를 완전히 갈라서"
 },
 {
  "i": 30,
  "t0": 82.882,
  "t1": 85.385,
  "text": "서로 다른 잣대를 들이대겠다는 겁니다"
 },
 {
  "i": 31,
  "t0": 85.385,
  "t1": 87.087,
  "text": "첫째는 '급여'인데요"
 },
 {
  "i": 32,
  "t0": 87.087,
  "t1": 90.924,
  "text": "결론부터 말씀드리면 여기는 다행히 큰 변화가 없습니다"
 },
 {
  "i": 33,
  "t0": 90.924,
  "t1": 92.959,
  "text": "우리가 가장 무서워하는 게 뭔가요?"
 },
 {
  "i": 34,
  "t0": 92.959,
  "t1": 96.262,
  "text": "암이나 뇌혈관 질환 같은 중증이죠"
 },
 {
  "i": 35,
  "t0": 96.262,
  "t1": 98.364,
  "text": "이 같은 중증으로 입원하면"
 },
 {
  "i": 36,
  "t0": 98.364,
  "t1": 101.267,
  "text": "대부분 급여 항목으로 치료를 받게 되는데요,"
 },
 {
  "i": 37,
  "t0": 101.267,
  "t1": 104.838,
  "text": "이런 필수 치료까지는 건드리지 않겠다는 겁니다"
 },
 {
  "i": 38,
  "t0": 104.838,
  "t1": 110.443,
  "text": "이번 기준으로 지금 4세대와 같은 본인 부담률 20%가 유지됩니다"
 },
 {
  "i": 39,
  "t0": 110.443,
  "t1": 116.316,
  "text": "다시 말해 건강보험이 적용되는 병원비는 내가 20%만 내면"
 },
 {
  "i": 40,
  "t0": 116.316,
  "t1": 121.321,
  "text": "나머지 80%는 5세대에서도 실손이 책임진다는 이야기입니다"
 },
 {
  "i": 41,
  "t0": 121.321,
  "t1": 123.69,
  "text": "오히려 더 좋아지는 부분도 있습니다"
 },
 {
  "i": 42,
  "t0": 123.69,
  "t1": 127.56,
  "text": "그러니 급여 쪽은 걱정을 내려놓으셔도 되겠습니다"
 },
 {
  "i": 43,
  "t0": 127.56,
  "t1": 130.997,
  "text": "둘째, 진짜 문제는 바로 '비급여'인데요"
 },
 {
  "i": 44,
  "t0": 130.997,
  "t1": 134.968,
  "text": "실손 적자의 주범으로 지목된 게 비급여다 보니"
 },
 {
  "i": 45,
  "t0": 134.968,
  "t1": 138.771,
  "text": "이번 개편의 칼끝이 전부 여기를 향해 있습니다"
 },
 {
  "i": 46,
  "t0": 138.771,
  "t1": 141.841,
  "text": "5세대는 비급여를 환자 상태에 따라"
 },
 {
  "i": 47,
  "t0": 141.841,
  "t1": 145.979,
  "text": "'중증 비급여'와 '비중증 비급여' 둘로 쪼개는 겁니다"
 },
 {
  "i": 48,
  "t0": 145.979,
  "t1": 150.383,
  "text": "생명이 걸린 중증 비급여는 지금 수준을 지켜주지만,"
 },
 {
  "i": 49,
  "t0": 150.383,
  "t1": 153.887,
  "text": "동네병원에서 흔히 받을 수 있는 비중증 비급여는"
 },
 {
  "i": 50,
  "t0": 153.887,
  "t1": 158.892,
  "text": "본인 부담률이 기존 30%에서 50%까지 올라갑니다"
 },
 {
  "i": 51,
  "t0": 158.892,
  "t1": 160.26,
  "text": "숫자로 확인해 볼까요?"
 },
 {
  "i": 52,
  "t0": 160.26,
  "t1": 163.196,
  "text": "허리가 아파서 정형외과를 다녀오고"
 },
 {
  "i": 53,
  "t0": 163.196,
  "t1": 166.399,
  "text": "비급여 치료비가 20만원 나왔다고 해보죠"
 },
 {
  "i": 54,
  "t0": 166.399,
  "t1": 169.869,
  "text": "1세대 가입자라면 공제금 몇천원 수준만 빼고"
 },
 {
  "i": 55,
  "t0": 169.869,
  "t1": 171.638,
  "text": "거의 전액을 돌려받습니다"
 },
 {
  "i": 56,
  "t0": 171.638,
  "t1": 176.476,
  "text": "그런데 5세대는 치료비의 50%와 5만원 중에서"
 },
 {
  "i": 57,
  "t0": 176.476,
  "t1": 178.444,
  "text": "큰 금액을 본인이 부담합니다"
 },
 {
  "i": 58,
  "t0": 178.444,
  "t1": 182.148,
  "text": "20만원이면 50%인 10만원을 내야 합니다"
 },
 {
  "i": 59,
  "t0": 182.148,
  "t1": 185.084,
  "text": "받을 수 있는 총액도 확 줄어들었습니다"
 },
 {
  "i": 60,
  "t0": 185.084,
  "t1": 187.72,
  "text": "비중증 비급여 연간 한도가요?"
 },
 {
  "i": 61,
  "t0": 187.72,
  "t1": 190.79,
  "text": "기존 5,000만원에서 1,000만원으로 줄고요,"
 },
 {
  "i": 62,
  "t0": 190.79,
  "t1": 195.495,
  "text": "통원은 하루 20만원, 입원은 한 번에 300만원까지로 묶입니다"
 },
 {
  "i": 63,
  "t0": 195.495,
  "t1": 199.532,
  "text": "비싼 비급여 시술 몇 번이면 그 한도가 다 차버려서요"
 },
 {
  "i": 64,
  "t0": 199.532,
  "t1": 202.702,
  "text": "그 다음부터는 전부 내 돈으로 지불해야 하는 겁니다"
 },
 {
  "i": 65,
  "t0": 202.702,
  "t1": 206.839,
  "text": "즉, 비중증 비급여 치료에서 체감이 확 되는 겁니다"
 },
 {
  "i": 66,
  "t0": 206.839,
  "t1": 210.643,
  "text": "세 번째, 개인적으로 가장 눈여겨보는 대목입니다"
 },
 {
  "i": 67,
  "t0": 210.643,
  "t1": 211.978,
  "text": "바로 '면책'인데요"
 },
 {
  "i": 68,
  "t0": 211.978,
  "t1": 215.148,
  "text": "아예 보험금을 주지 않는 항목이 늘어나는 겁니다"
 },
 {
  "i": 69,
  "t0": 215.148,
  "t1": 217.116,
  "text": "지금까지 면책이라고 하면"
 },
 {
  "i": 70,
  "t0": 217.116,
  "t1": 221.688,
  "text": "쌍꺼플 수술이나 지방흡입 같은 '미용・성형' 정도였습니다"
 },
 {
  "i": 71,
  "t0": 221.688,
  "t1": 224.424,
  "text": "누가 봐도 고개가 끄덕여지는 범위였죠"
 },
 {
  "i": 72,
  "t0": 224.424,
  "t1": 230.23,
  "text": "그런데 5세대에서는 신평원에 등재되지 않은 신의료기술에 더해서"
 },
 {
  "i": 73,
  "t0": 230.23,
  "t1": 234.1,
  "text": "직장인들이 많이 받는 근골격계 치료 목적의 주사제,"
 },
 {
  "i": 74,
  "t0": 234.1,
  "t1": 236.636,
  "text": "즉, 허리디스크로 주사 치료하는 거 있죠?"
 },
 {
  "i": 75,
  "t0": 236.636,
  "t1": 239.939,
  "text": "그런 부분들도 이제 면책 대상에 포함됩니다"
 },
 {
  "i": 76,
  "t0": 239.939,
  "t1": 240.907,
  "text": "그렇게 되면"
 },
 {
  "i": 77,
  "t0": 240.907,
  "t1": 245.345,
  "text": "\"이제 실비되니까 무조건 치료받자!\"와 같은 시대는 끝나구요"
 },
 {
  "i": 78,
  "t0": 245.345,
  "t1": 249.215,
  "text": "치료비의 상당 부분을 내 지갑에서 꺼내야 하는 겁니다"
 },
 {
  "i": 79,
  "t0": 249.215,
  "t1": 253.286,
  "text": "이제 치료를 결정하기 전에 비용부터 따져보는 습관이"
 },
 {
  "i": 80,
  "t0": 253.286,
  "t1": 254.854,
  "text": "필요한 시대가 된 겁니다"
 },
 {
  "i": 81,
  "t0": 254.854,
  "t1": 258.992,
  "text": "다시 말해, 가벼운 질환인 비중증 비급여 치료에 대해서는"
 },
 {
  "i": 82,
  "t0": 258.992,
  "t1": 263.596,
  "text": "부담률도 올라가고 면책 사항도 늘어났다고 보시면 되겠습니다"
 },
 {
  "i": 83,
  "t0": 263.596,
  "t1": 264.931,
  "text": "여기까지 들으시고"
 },
 {
  "i": 84,
  "t0": 264.931,
  "t1": 270.637,
  "text": "\"저건 새로 가입할 사람들 얘기고, 나는 옛날 실비니까 남일이다!\""
 },
 {
  "i": 85,
  "t0": 270.637,
  "t1": 272.872,
  "text": "싶으신 분들 분명히 계실 겁니다"
 },
 {
  "i": 86,
  "t0": 272.872,
  "t1": 275.708,
  "text": "그런 분들일수록 지금부터가 진짜입니다"
 },
 {
  "i": 87,
  "t0": 275.708,
  "t1": 281.014,
  "text": "영상 끝나고 나서 내 증권을 꼭 다시 꺼내보셔야 하는 이유가 있는데요"
 },
 {
  "i": 88,
  "t0": 281.014,
  "t1": 285.618,
  "text": "바로 약관 속에 조용히 숨어있는 '재가입 주기' 때문입니다"
 },
 {
  "i": 89,
  "t0": 285.618,
  "t1": 287.754,
  "text": "이런 내용 모르면 손해니까요"
 },
 {
  "i": 90,
  "t0": 287.754,
  "t1": 290.523,
  "text": "지금 구독해 두시면 다음 중요한 소식도"
 },
 {
  "i": 91,
  "t0": 290.523,
  "t1": 292.592,
  "text": "빠짐없이 받아보실 수 있습니다"
 },
 {
  "i": 92,
  "t0": 292.592,
  "t1": 294.827,
  "text": "자, 재가입 주기가 뭐냐"
 },
 {
  "i": 93,
  "t0": 294.827,
  "t1": 297.563,
  "text": "우리가 전세 계약을 떠올리시면 쉬운데요"
 },
 {
  "i": 94,
  "t0": 297.563,
  "t1": 300.867,
  "text": "계약 기간이 끝나면 내가 살던 조건이 아니라"
 },
 {
  "i": 95,
  "t0": 300.867,
  "t1": 304.404,
  "text": "그 시점의 시세와 조건으로 재계약해야 하잖아요?"
 },
 {
  "i": 96,
  "t0": 304.404,
  "t1": 306.339,
  "text": "실손도 마찬가지입니다"
 },
 {
  "i": 97,
  "t0": 306.339,
  "t1": 310.31,
  "text": "약관에 재가입 주기가 있으면 그 기간이 끝나는 순간,"
 },
 {
  "i": 98,
  "t0": 310.31,
  "t1": 314.48,
  "text": "그때 팔리고 있는 세대의 상품으로 갈아타게 되는 겁니다"
 },
 {
  "i": 99,
  "t0": 314.48,
  "t1": 317.383,
  "text": "\"저는 옛날 조건으로 계속 낼게요\"를"
 },
 {
  "i": 100,
  "t0": 317.383,
  "t1": 319.519,
  "text": "선택할 수 없다는 게 핵심입니다"
 },
 {
  "i": 101,
  "t0": 319.519,
  "t1": 321.354,
  "text": "세대별로 정리해볼까요?"
 },
 {
  "i": 102,
  "t0": 321.354,
  "t1": 326.759,
  "text": "1세대와 2세대 초기형, 2013년 4월 이전에 가입자는"
 },
 {
  "i": 103,
  "t0": 326.759,
  "t1": 328.628,
  "text": "재가입 주기가 없습니다"
 },
 {
  "i": 104,
  "t0": 328.628,
  "t1": 332.231,
  "text": "앞으로 갱신되는 갱신 보험료만 감당되면"
 },
 {
  "i": 105,
  "t0": 332.231,
  "t1": 334.033,
  "text": "조건은 평생 가는 겁니다"
 },
 {
  "i": 106,
  "t0": 334.033,
  "t1": 339.939,
  "text": "반면 2013년 4월 이후에 2세대 후기부터 3세대, 4세대까지는"
 },
 {
  "i": 107,
  "t0": 339.939,
  "t1": 343.509,
  "text": "15년 또는 5년에 재가입 주기가 붙어있습니다"
 },
 {
  "i": 108,
  "t0": 343.509,
  "t1": 346.946,
  "text": "2013년 4월 이후에 가입하신 분들이라면"
 },
 {
  "i": 109,
  "t0": 346.946,
  "t1": 349.115,
  "text": "15년 재가입 주기니까요"
 },
 {
  "i": 110,
  "t0": 349.115,
  "t1": 354.787,
  "text": "2028년, 바로 내 후년에 5세대나 그 이후 세대로 전환됩니다"
 },
 {
  "i": 111,
  "t0": 354.787,
  "t1": 358.791,
  "text": "규모로 보면 전체 실손가입자 4,000만명 중에"
 },
 {
  "i": 112,
  "t0": 358.791,
  "t1": 359.726,
  "text": "평생 조건이 유지되는 분은 약 1,600만명,"
 },
 {
  "i": 113,
  "t0": 359.726,
  "t1": 362.595,
  "text": "평생 조건이 유지되는 분은 약 1,600만명,"
 },
 {
  "i": 114,
  "t0": 362.595,
  "t1": 367.033,
  "text": "나머지 2,400만명은 언젠가 전환을 맞이합니다"
 },
 {
  "i": 115,
  "t0": 367.033,
  "t1": 371.404,
  "text": "1・2세대 1,600만명도 사실 보험료 인상으로 인해"
 },
 {
  "i": 116,
  "t0": 371.404,
  "t1": 374.64,
  "text": "언젠간 버티지 못하고 전환하게 되는 분들이"
 },
 {
  "i": 117,
  "t0": 374.64,
  "t1": 377.343,
  "text": "대부분일 거라는 것도 기정 사실입니다"
 },
 {
  "i": 118,
  "t0": 377.343,
  "t1": 379.345,
  "text": "지금 체감이 안 되시더라도"
 },
 {
  "i": 119,
  "t0": 379.345,
  "t1": 381.781,
  "text": "그날이 오면 달라진 조건 때문에"
 },
 {
  "i": 120,
  "t0": 381.781,
  "t1": 384.25,
  "text": "병원비 계획을 다시 짜야 합니다"
 },
 {
  "i": 121,
  "t0": 384.25,
  "t1": 386.619,
  "text": "그래서 오늘 드리는 숙제는 이겁니다"
 },
 {
  "i": 122,
  "t0": 386.619,
  "t1": 389.722,
  "text": "내 증권에서 재가입 주기가 있는지"
 },
 {
  "i": 123,
  "t0": 389.722,
  "t1": 393.292,
  "text": "만기 날짜가 언제인지부터 꼭 확인하시구요"
 },
 {
  "i": 124,
  "t0": 393.292,
  "t1": 397.397,
  "text": "약관 분석이 필요하면 아래 링크를 눌러 상담을 요청해 주세요"
 },
 {
  "i": 125,
  "t0": 397.397,
  "t1": 400.032,
  "text": "자, 그럼 재가입 주기가 없는"
 },
 {
  "i": 126,
  "t0": 400.032,
  "t1": 404.203,
  "text": "1세대, 2세대 초기 가입자분들은 안심해도 괜찮을까요?"
 },
 {
  "i": 127,
  "t0": 404.203,
  "t1": 405.705,
  "text": "그렇게 간단하지가 않습니다"
 },
 {
  "i": 128,
  "t0": 405.705,
  "t1": 409.475,
  "text": "보험사 입장에서 1・2세대 실손는 유지할수록"
 },
 {
  "i": 129,
  "t0": 409.475,
  "t1": 411.444,
  "text": "적자가 쌓이는 계약입니다"
 },
 {
  "i": 130,
  "t0": 411.444,
  "t1": 414.781,
  "text": "그래서 금융당국과 여러 방안이 논의됐는데,"
 },
 {
  "i": 131,
  "t0": 414.781,
  "t1": 419.519,
  "text": "처음엔 법을 바꿔서 일괄 전환하자는 안까지 검토됐다가"
 },
 {
  "i": 132,
  "t0": 419.519,
  "t1": 421.754,
  "text": "정당하게 맺은 기존 계약을"
 },
 {
  "i": 133,
  "t0": 421.754,
  "t1": 424.924,
  "text": "강제로 바꿀 수는 없다는 결론으로 무산됐죠"
 },
 {
  "i": 134,
  "t0": 424.924,
  "t1": 427.393,
  "text": "대신 나온 카드가 바로 계약 재매입,"
 },
 {
  "i": 135,
  "t0": 427.393,
  "t1": 431.831,
  "text": "그러니까 옛날 계약을 정리하는 대가로 보상을 제공하고"
 },
 {
  "i": 136,
  "t0": 431.831,
  "t1": 434.5,
  "text": "5세대로 전환을 유도하는 방식입니다"
 },
 {
  "i": 137,
  "t0": 434.5,
  "t1": 436.702,
  "text": "여기부터가 오늘의 핵심인데요"
 },
 {
  "i": 138,
  "t0": 436.702,
  "t1": 441.507,
  "text": "작년 말까지만 해도 언론에 유력하게 보도된 안은 이랬습니다"
 },
 {
  "i": 139,
  "t0": 441.507,
  "t1": 447.313,
  "text": "내가 낸 보험료 총액에서 받아간 보험금을 뺀 차액을 현금으로 돌려준다"
 },
 {
  "i": 140,
  "t0": 447.313,
  "t1": 449.849,
  "text": "즉, 보험료로 낸 돈이 1,000만원이라면,"
 },
 {
  "i": 141,
  "t0": 449.849,
  "t1": 453.319,
  "text": "그리고 청구에서 보상받은 돈이 300만원이라면"
 },
 {
  "i": 142,
  "t0": 453.319,
  "t1": 456.889,
  "text": "그 차액인 700만원을 손에 쥐는 그림이었죠"
 },
 {
  "i": 143,
  "t0": 456.889,
  "t1": 460.593,
  "text": "그래서 \"얼마 받고 팔까?\"라는 기대가 커졌던 겁니다"
 },
 {
  "i": 144,
  "t0": 460.593,
  "t1": 465.832,
  "text": "그런데 올해 5월 최종 발표에서 이 현금 보상은 빠졌습니다"
 },
 {
  "i": 145,
  "t0": 465.832,
  "t1": 470.203,
  "text": "대신 확정된 것이 계약 전환 시에 할인해주는 제도입니다"
 },
 {
  "i": 146,
  "t0": 470.203,
  "t1": 474.841,
  "text": "재가입 주기가 없는 1세대, 2세대 가입자가 5세대로 갈아타게 되면"
 },
 {
  "i": 147,
  "t0": 474.841,
  "t1": 479.912,
  "text": "5세대 보험료를 3년간 50%를 할인해주는 방식인 겁니다"
 },
 {
  "i": 148,
  "t0": 479.912,
  "t1": 481.781,
  "text": "감이 오시게 숫자를 넣어보면"
 },
 {
  "i": 149,
  "t0": 481.781,
  "t1": 484.951,
  "text": "5세대 보험료가 월 4만원이라고 할 때"
 },
 {
  "i": 150,
  "t0": 484.951,
  "t1": 488.554,
  "text": "3년간 아끼는 돈은 약 70만원 남짓입니다"
 },
 {
  "i": 151,
  "t0": 488.554,
  "t1": 491.691,
  "text": "10년 넘게 지켜온 1・2세대세대 보장을"
 },
 {
  "i": 152,
  "t0": 491.691,
  "t1": 493.893,
  "text": "내려놓는 대가로 받는 혜택이"
 },
 {
  "i": 153,
  "t0": 493.893,
  "t1": 495.995,
  "text": "목돈이 아니라 할인이라는 것,"
 },
 {
  "i": 154,
  "t0": 495.995,
  "t1": 498.598,
  "text": "기대와는 거리가 있는 게 사실입니다"
 },
 {
  "i": 155,
  "t0": 498.598,
  "t1": 500.099,
  "text": "일정도 중요한데요"
 },
 {
  "i": 156,
  "t0": 500.099,
  "t1": 503.069,
  "text": "이 제도는 올해 11월부터 시행되고"
 },
 {
  "i": 157,
  "t0": 503.069,
  "t1": 507.073,
  "text": "일단 6개월간 운영한 뒤에 연장 여부를 다시 정합니다"
 },
 {
  "i": 158,
  "t0": 507.073,
  "t1": 511.11,
  "text": "여기까지 따라오셨으면 이제 어떻게 할지 판단 기준을 알려드릴게요"
 },
 {
  "i": 159,
  "t0": 511.11,
  "t1": 512.178,
  "text": "딱 두 가지인데요"
 },
 {
  "i": 160,
  "t0": 512.178,
  "t1": 516.983,
  "text": "첫째는 증권에 재가입 주기 5년, 15년이 적혀있는 분들,"
 },
 {
  "i": 161,
  "t0": 516.983,
  "t1": 520.786,
  "text": "이분들 \"어차피 전환될 거 미리 5세대로 갈아탈까?\""
 },
 {
  "i": 162,
  "t0": 520.786,
  "t1": 523.289,
  "text": "하는 조급함이 생기실 수 있는데,"
 },
 {
  "i": 163,
  "t0": 523.289,
  "t1": 525.725,
  "text": "제 답은 \"먼저 움직이지 마라\"입니다"
 },
 {
  "i": 164,
  "t0": 525.725,
  "t1": 528.928,
  "text": "보험료가 가게를 흔들 정도가 아니라고 한다면,"
 },
 {
  "i": 165,
  "t0": 528.928,
  "t1": 531.697,
  "text": "지금의 좋은 조건을 내 손으로 먼저 반납할"
 },
 {
  "i": 166,
  "t0": 531.697,
  "t1": 533.232,
  "text": "이유는 없는 겁니다"
 },
 {
  "i": 167,
  "t0": 533.232,
  "t1": 536.636,
  "text": "때가 되면 약관에 따라 자동으로 전환되니"
 },
 {
  "i": 168,
  "t0": 536.636,
  "t1": 538.971,
  "text": "그때까지 혜택을 누리는 것이"
 },
 {
  "i": 169,
  "t0": 538.971,
  "t1": 542.742,
  "text": "약관 안에서 소비자가 할 수 있는 최선의 선택입니다"
 },
 {
  "i": 170,
  "t0": 542.742,
  "t1": 544.41,
  "text": "그리고 전환하더라도"
 },
 {
  "i": 171,
  "t0": 544.41,
  "t1": 548.314,
  "text": "11월 할인 시기에 맞춰서 전환하는 게 좋겠습니다"
 },
 {
  "i": 172,
  "t0": 548.314,
  "t1": 552.518,
  "text": "두 번째 재가입 주기가 없는 1・2세대 초기 가입자분들"
 },
 {
  "i": 173,
  "t0": 552.518,
  "t1": 554.12,
  "text": "보장 좋은 건 아는데"
 },
 {
  "i": 174,
  "t0": 554.12,
  "t1": 557.056,
  "text": "갱신 때마다 몇만원이던 보험료가"
 },
 {
  "i": 175,
  "t0": 557.056,
  "t1": 559.525,
  "text": "결국 15만원, 20만원까지 뛰니"
 },
 {
  "i": 176,
  "t0": 559.525,
  "t1": 563.162,
  "text": "이번 기회 싼 걸로 갈아탈까 고민되실 겁니다"
 },
 {
  "i": 177,
  "t0": 563.162,
  "t1": 565.998,
  "text": "그 마음 상담하면서 많이 만나봤는데요"
 },
 {
  "i": 178,
  "t0": 565.998,
  "t1": 568.134,
  "text": "하지만 이것 하나만 기억하세요?"
 },
 {
  "i": 179,
  "t0": 568.134,
  "t1": 569.969,
  "text": "보험료가 아무리 부담돼도"
 },
 {
  "i": 180,
  "t0": 569.969,
  "t1": 571.938,
  "text": "결정은 '계산 후'입니다"
 },
 {
  "i": 181,
  "t0": 571.938,
  "t1": 576.842,
  "text": "내가 낸 돈, 받은 돈, 남은 보장의 가치를 숫자로 확인한 뒤에"
 },
 {
  "i": 182,
  "t0": 576.842,
  "t1": 579.612,
  "text": "전환을 정해도 절대 늦지 않습니다"
 },
 {
  "i": 183,
  "t0": 579.612,
  "t1": 582.415,
  "text": "마지막으로 제 생각 하나만 말씀드리면요"
 },
 {
  "i": 184,
  "t0": 582.415,
  "t1": 587.219,
  "text": "내 실손보험의 가치는 보험사의 계산기가 정하는 게 아닙니다"
 },
 {
  "i": 185,
  "t0": 587.219,
  "t1": 590.456,
  "text": "앞으로 내가 쓰게 될 병원비가 정하는 거죠"
 },
 {
  "i": 186,
  "t0": 590.456,
  "t1": 592.325,
  "text": "당장 할인 혜택이 아니라"
 },
 {
  "i": 187,
  "t0": 592.325,
  "t1": 596.095,
  "text": "10년 뒤, 20년 뒤에 내 건강까지 놓고서"
 },
 {
  "i": 188,
  "t0": 596.095,
  "t1": 598.264,
  "text": "저울질해 보셔야 하겠습니다"
 },
 {
  "i": 189,
  "t0": 598.264,
  "t1": 600.933,
  "text": "그래서 오늘 숙제 딱 하나만 드린다면"
 },
 {
  "i": 190,
  "t0": 600.933,
  "t1": 605.004,
  "text": "내 증권을 꺼내서 재가입 주기가 있는지 없는지부터"
 },
 {
  "i": 191,
  "t0": 605.004,
  "t1": 606.339,
  "text": "확인해 보셔야 됩니다"
 },
 {
  "i": 192,
  "t0": 606.339,
  "t1": 608.708,
  "text": "그게 모든 판단의 출발점이고요"
 },
 {
  "i": 193,
  "t0": 608.708,
  "t1": 612.445,
  "text": "확인해 보시고도 헷갈리시면 혼자 고민하지 마시고"
 },
 {
  "i": 194,
  "t0": 612.445,
  "t1": 614.513,
  "text": "편하게 상담을 요청해 주세요"
 },
 {
  "i": 195,
  "t0": 614.513,
  "t1": 618.017,
  "text": "내가 낸 보험료와 받은 보험금 같이 계산해보면"
 },
 {
  "i": 196,
  "t0": 618.017,
  "t1": 619.752,
  "text": "답이 명확해질 겁니다"
 },
 {
  "i": 197,
  "t0": 619.752,
  "t1": 623.856,
  "text": "그리고 오늘 이 내용, 부모님 세대가 제일 많이 해당되니까요"
 },
 {
  "i": 198,
  "t0": 623.856,
  "t1": 626.959,
  "text": "오늘 영상 꼭 가족분들께 공유해 주시고요,"
 },
 {
  "i": 199,
  "t0": 626.959,
  "t1": 629.962,
  "text": "도움 되셨다면 구독과 좋아요 부탁드리겠습니다"
 },
 {
  "i": 200,
  "t0": 629.962,
  "t1": 632.932,
  "text": "다음 시간에도 여러분들의 보험료를 지켜드릴"
 },
 {
  "i": 201,
  "t0": 632.932,
  "t1": 634.867,
  "text": "알짜 정보로 찾아뵙겠습니다"
 },
 {
  "i": 202,
  "t0": 634.867,
  "t1": 635.735,
  "text": "감사합니다"
 }
]