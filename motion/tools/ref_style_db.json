 "captions_01R": [
  {
   "t0": 0,
   "t1": 3.0,
   "text": "자궁근종 떼어냈는데 500만 원 지급"
  },
  {
   "t0": 3.0,
   "t1": 6.01,
   "text": "백내장 수술했는데 100만 원 주는 보험"
  },
  {
   "t0": 6.01,
   "t1": 8.64,
   "text": "건강보험인데도 임플란트 했다고"
  },
  {
   "t0": 8.64,
   "t1": 10.14,
   "text": "100만 원 지급하는 보험"
  },
  {
   "t0": 10.14,
   "t1": 12.95,
   "text": "여러분들이라면 이런 보험 해지하시겠습니까?"
  },
  {
   "t0": 12.95,
   "t1": 14.58,
   "text": "절대 해지 안 하시겠죠"
  },
  {
   "t0": 14.58,
   "t1": 16.38,
   "text": "최근 상담했던 어머님이"
  },
  {
   "t0": 16.38,
   "t1": 17.98,
   "text": "보험료가 부담되어서"
  },
  {
   "t0": 17.98,
   "t1": 20.09,
   "text": "보험을 대대적으로 정리했는데요"
  },
  {
   "t0": 20.09,
   "t1": 23.26,
   "text": "지금 말씀드린 이 보험을 해지한 겁니다"
  },
  {
   "t0": 23.26,
   "t1": 24.66,
   "text": "이거 정말 좋은 보험이라서"
  },
  {
   "t0": 24.66,
   "t1": 26.46,
   "text": "함부로 해지하면 안 되는 거거든요"
  },
  {
   "t0": 26.46,
   "t1": 28.86,
   "text": "흔히 설계사들 사이에서는 이 보험을"
  },
  {
   "t0": 28.86,
   "t1": 30.9,
   "text": "\"보험사가 실수로 만든 보험\""
  },
  {
   "t0": 30.9,
   "t1": 33.87,
   "text": "\"이 보험 만든 직원 결국 잘렸다\"라고"
  },
  {
   "t0": 33.87,
   "t1": 36.07,
   "text": "말할 정도로 좋은 보험인데"
  },
  {
   "t0": 36.07,
   "t1": 37.47,
   "text": "이걸 해지한 겁니다"
  },
  {
   "t0": 37.47,
   "t1": 39.24,
   "text": "이제는 가입하고 싶어도"
  },
  {
   "t0": 39.24,
   "t1": 41.84,
   "text": "보험사가 만들지를 않기 때문에"
  },
  {
   "t0": 41.84,
   "t1": 43.58,
   "text": "가입할 수가 없는 보험"
  },
  {
   "t0": 43.58,
   "t1": 46.98,
   "text": "여러분들 혹시 보험 정리 고민하시고 계시면"
  },
  {
   "t0": 46.98,
   "t1": 49.62,
   "text": "지금 이 영상 무조건 끝까지 보시고"
  },
  {
   "t0": 49.62,
   "t1": 52.49,
   "text": "똑같은 실수 하지 마시기를 바라겠습니다"
  },
  {
   "t0": 52.49,
   "t1": 54.59,
   "text": "영상 보시고 그냥 나가시면"
  },
  {
   "t0": 54.59,
   "t1": 58.16,
   "text": "앞으로 소개할 더 좋은 내용들 다 놓치시게 되니까요"
  },
  {
   "t0": 58.16,
   "t1": 60.76,
   "text": "지금 구독 알림 설정 해 두시고요"
  },
  {
   "t0": 60.76,
   "t1": 62.3,
   "text": "바로 시작하도록 하겠습니다"
  },
  {
   "t0": 62.3,
   "t1": 64.63,
   "text": "절대 해지하면 안 되는 보험"
  },
  {
   "t0": 64.73,
   "t1": 67.97,
   "text": "첫 번째, 1-3종 수술비 특약입니다"
  },
  {
   "t0": 67.97,
   "t1": 70.34,
   "text": "이게 정말 많이들 해지했는데요"
  },
  {
   "t0": 70.34,
   "t1": 72.04,
   "text": "정말 아까운 보험입니다"
  },
  {
   "t0": 72.04,
   "t1": 75.21,
   "text": "2007년 이후로 1-3종 수술비는"
  },
  {
   "t0": 75.21,
   "t1": 77.21,
   "text": "더 이상 만들지 않았기 때문에"
  },
  {
   "t0": 77.21,
   "t1": 79.41,
   "text": "이제는 가입할 수가 없습니다"
  },
  {
   "t0": 79.41,
   "t1": 82.75,
   "text": "그런데 아직도 이 보험을 갖고 계신다?"
  },
  {
   "t0": 82.75,
   "t1": 83.88,
   "text": "축하드립니다"
  },
  {
   "t0": 83.88,
   "t1": 86.32,
   "text": "절대 해지하시면 안 되겠습니다"
  },
  {
   "t0": 86.32,
   "t1": 88.15,
   "text": "1-3종 수술비는요"
  },
  {
   "t0": 88.15,
   "t1": 90.72,
   "text": "수술을 난이도와 위험도에 따라"
  },
  {
   "t0": 90.72,
   "t1": 92.49,
   "text": "1~3종으로 나누고요"
  },
  {
   "t0": 92.49,
   "t1": 95.73,
   "text": "종마다 금액을 다르게 지급하는 방식입니다"
  },
  {
   "t0": 95.73,
   "t1": 97.8,
   "text": "1종은 비교적 흔한 수술,"
  },
  {
   "t0": 97.8,
   "t1": 99.37,
   "text": "2종은 중간 난이도,"
  },
  {
   "t0": 99.37,
   "t1": 103.6,
   "text": "3종은 암, 뇌, 심장처럼 고난도의 큰 수술입니다"
  },
  {
   "t0": 103.6,
   "t1": 107.31,
   "text": "보험사는 왜 1-3종 수술비를 단종시켰을까요?"
  },
  {
   "t0": 107.31,
   "t1": 108.51,
   "text": "이유는 간단합니다"
  },
  {
   "t0": 108.51,
   "t1": 110.38,
   "text": "청구가 폭발했던"
  },
  {
   "t0": 110.38,
   "t1": 112.88,
   "text": "그만큼 좋은 담보였기 때문입니다"
  },
  {
   "t0": 112.88,
   "t1": 115.98,
   "text": "보험사 입장에서 손해를 보는 보험이 있다면"
  },
  {
   "t0": 115.98,
   "t1": 118.59,
   "text": "결국에는 못 버티고 바꿔야 하고요"
  },
  {
   "t0": 118.59,
   "t1": 120.79,
   "text": "이후에 새로 만들더라도"
  },
  {
   "t0": 120.79,
   "t1": 123.96,
   "text": "보장을 축소하거나 까다롭게 만들기도 합니다"
  },
  {
   "t0": 123.96,
   "t1": 126.29,
   "text": "그런 부분에서 1-3종 수술비는"
  },
  {
   "t0": 126.29,
   "t1": 128.6,
   "text": "당시에 좋은 부분이 많았습니다"
  },
  {
   "t0": 128.6,
   "t1": 131.26,
   "text": "그중에서 지금 말씀드릴 이야기를 하면"
  },
  {
   "t0": 131.26,
   "t1": 134.43,
   "text": "다들 \"정말 그런 게 있었냐?\" 하고 놀라시던데"
  },
  {
   "t0": 134.43,
   "t1": 136.17,
   "text": "1-3종 수술비는요"
  },
  {
   "t0": 136.17,
   "t1": 140.54,
   "text": "무려 임플란트도 보장해 주던 전설의 보험이었습니다"
  },
  {
   "t0": 140.54,
   "t1": 141.98,
   "text": "모든 임플란트는 아니고"
  },
  {
   "t0": 141.98,
   "t1": 144.94,
   "text": "잇몸이 약해서 치조골 이식과 함께"
  },
  {
   "t0": 144.94,
   "t1": 146.88,
   "text": "임플란트를 하는 경우가 있잖아요?"
  },
  {
   "t0": 146.88,
   "t1": 149.18,
   "text": "이때 2종에 해당되면서"
  },
  {
   "t0": 149.18,
   "t1": 151.52,
   "text": "100만 원 이상을 받을 수 있었습니다"
  },
  {
   "t0": 151.52,
   "t1": 155.99,
   "text": "지금은 치조골 이식을 보장하는 수술비가 거의 없기 때문에"
  },
  {
   "t0": 155.99,
   "t1": 158.36,
   "text": "가치가 매우 높은 담보였습니다"
  },
  {
   "t0": 158.36,
   "t1": 161.43,
   "text": "그리고 나이 들면 대부분 하는 수술이 있죠?"
  },
  {
   "t0": 161.43,
   "t1": 162.43,
   "text": "백내장"
  },
  {
   "t0": 162.43,
   "t1": 164.5,
   "text": "백내장도 메리트가 있었는데요"
  },
  {
   "t0": 164.5,
   "t1": 168.6,
   "text": "1~3종에서는 이 백내장이 2종에 해당되면서"
  },
  {
   "t0": 168.6,
   "t1": 170.54,
   "text": "100만 원가량을 받았습니다"
  },
  {
   "t0": 170.54,
   "t1": 174.17,
   "text": "그리고 치액제거, 자궁근종, 용종제거 등"
  },
  {
   "t0": 174.17,
   "t1": 176.54,
   "text": "실생활에서 많이들 하는 수술들을"
  },
  {
   "t0": 176.54,
   "t1": 178.98,
   "text": "대부분 쉽게 보상해 줬기 때문에"
  },
  {
   "t0": 178.98,
   "t1": 181.28,
   "text": "우리들의 만족도는 매우 높았지만"
  },
  {
   "t0": 181.28,
   "t1": 184.05,
   "text": "보험사는 손해율을 이겨내지 못하고"
  },
  {
   "t0": 184.05,
   "t1": 186.59,
   "text": "결국 삭제할 수밖에 없었습니다"
  },
  {
   "t0": 186.59,
   "t1": 187.89,
   "text": "내용이 좋다고요?"
  },
  {
   "t0": 187.89,
   "t1": 190.52,
   "text": "그럼 바로 구독부터 누르고 이어서 가볼까요?"
  },
  {
   "t0": 190.66,
   "t1": 194.56,
   "text": "해지하면 안 되는 두 번째 보험 여성보험입니다"
  },
  {
   "t0": 194.56,
   "t1": 197.5,
   "text": "'여성보험'이란 이름만 보고 오해하시는 분들이"
  },
  {
   "t0": 197.5,
   "t1": 198.63,
   "text": "열에 아홉입니다"
  },
  {
   "t0": 198.63,
   "t1": 202.1,
   "text": "그런데 지금 설명드릴 이 내용을 모르시면요"
  },
  {
   "t0": 202.1,
   "t1": 205.0,
   "text": "여성보험의 장점을 하나도 모르는 겁니다"
  },
  {
   "t0": 205.0,
   "t1": 206.84,
   "text": "여성이라고 쓰여 있으니"
  },
  {
   "t0": 206.84,
   "t1": 208.98,
   "text": "\"여성 질환만 보장하는 거 아니야?\""
  },
  {
   "t0": 208.98,
   "t1": 210.34,
   "text": "라고 생각하셨죠?"
  },
  {
   "t0": 210.34,
   "t1": 211.31,
   "text": "아닙니다"
  },
  {
   "t0": 211.31,
   "t1": 213.71,
   "text": "여성보험의 장점이 몇 가지 있는데요"
  },
  {
   "t0": 213.71,
   "t1": 216.58,
   "text": "특정 수술의 지급액이 굉장히 컸습니다"
  },
  {
   "t0": 216.58,
   "t1": 218.65,
   "text": "예를 들어 수술할 때마다"
  },
  {
   "t0": 218.65,
   "t1": 222.99,
   "text": "300만 원, 500만 원을 정액으로 지급하는 형태가 많았는데요"
  },
  {
   "t0": 222.99,
   "t1": 224.32,
   "text": "어떤 질병이었냐고요?"
  },
  {
   "t0": 224.32,
   "t1": 227.23,
   "text": "지금도 많이 받는 자궁근종 수술이 있죠"
  },
  {
   "t0": 227.23,
   "t1": 228.96,
   "text": "당시에 500만 원 받았습니다"
  },
  {
   "t0": 228.96,
   "t1": 231.76,
   "text": "발가락이 휘는 무지외반증 아시죠?"
  },
  {
   "t0": 231.76,
   "t1": 235.57,
   "text": "사실 아주 흔한 증상이고 가벼운 수술로 끝나거든요"
  },
  {
   "t0": 235.57,
   "t1": 237.6,
   "text": "당시에 500만 원 받았습니다"
  },
  {
   "t0": 237.6,
   "t1": 242.21,
   "text": "그리고 여성보험이 체감상 만족도가 크게 컸던 이유 중 하나는"
  },
  {
   "t0": 242.21,
   "t1": 245.08,
   "text": "수술비 지급 조건이 단순했습니다"
  },
  {
   "t0": 245.08,
   "t1": 245.81,
   "text": "지금이야"
  },
  {
   "t0": 245.81,
   "t1": 249.78,
   "text": "지금이야 '질병코드', '수술분류표', '급여・비급여'의 여부 등을"
  },
  {
   "t0": 249.78,
   "t1": 252.25,
   "text": "복잡하게 따지는 시대가 되었잖아요"
  },
  {
   "t0": 252.25,
   "t1": 256.89,
   "text": "그런데 그 당시에는 지금보다 보상 구조가 훨씬 단순해서"
  },
  {
   "t0": 256.89,
   "t1": 258.16,
   "text": "지급이 잘 됐고요"
  },
  {
   "t0": 258.16,
   "t1": 262.43,
   "text": "결국 지급 금액이 크고 받기가 쉽다는 건 어떤 뜻인가요?"
  },
  {
   "t0": 262.43,
   "t1": 265.97,
   "text": "실손은 실손대로 청구해서 병원비를 커버해 주고"
  },
  {
   "t0": 265.97,
   "t1": 269.0,
   "text": "회복 기간 동안 잠시 일을 쉬거나 할 때"
  },
  {
   "t0": 269.0,
   "t1": 271.44,
   "text": "큼지막한 수술비가 쉽게 나오니까"
  },
  {
   "t0": 271.44,
   "t1": 273.67,
   "text": "생활의 공백을 뒷받침해 주니"
  },
  {
   "t0": 273.67,
   "t1": 275.04,
   "text": "얼마나 든든했을까요?"
  },
  {
   "t0": 275.04,
   "t1": 278.75,
   "text": "그래서 그만큼 가입자들의 만족도가 높았던 겁니다"
  },
  {
   "t0": 278.75,
   "t1": 282.32,
   "text": "그런데 이 상품은 2,000년대 들어서면서"
  },
  {
   "t0": 282.32,
   "t1": 283.82,
   "text": "대부분 사라졌는데요"
  },
  {
   "t0": 283.82,
   "t1": 285.72,
   "text": "그래서 지금 갖고 계시다면"
  },
  {
   "t0": 285.72,
   "t1": 288.39,
   "text": "납입이 끝났거나, 끝나가는 케이스겠죠"
  },
  {
   "t0": 288.39,
   "t1": 290.72,
   "text": "그래서 여성보험이 있으신 분은"
  },
  {
   "t0": 290.72,
   "t1": 292.66,
   "text": "절대 해지하시면 안 됩니다"
  },
  {
   "t0": 292.66,
   "t1": 295.66,
   "text": "혹시 여성보험 갖고 계신 분 계시면"
  },
  {
   "t0": 295.66,
   "t1": 297.23,
   "text": "댓글에 자랑 좀 해주세요 ㅎ"
  },
  {
   "t0": 297.36,
   "t1": 300.27,
   "text": "해지하면 안 되는 보험 세 번째 암 보험입니다"
  },
  {
   "t0": 300.27,
   "t1": 304.3,
   "text": "여기서부터는 진짜 아무도 안 알려주는 이야기입니다"
  },
  {
   "t0": 304.3,
   "t1": 307.61,
   "text": "모르고 갈아타면 몇 배로 손해 볼 수 있는데요"
  },
  {
   "t0": 307.61,
   "t1": 309.01,
   "text": "바로 '암 보험'입니다"
  },
  {
   "t0": 309.01,
   "t1": 310.81,
   "text": "암 보험이 별다른 게 있냐고요?"
  },
  {
   "t0": 310.81,
   "t1": 312.28,
   "text": "다 비슷한 거 아니냐고요?"
  },
  {
   "t0": 312.28,
   "t1": 314.48,
   "text": "이거 들어보시면 생각이 바뀌실 겁니다"
  },
  {
   "t0": 314.48,
   "t1": 317.52,
   "text": "암 보험은 '시기'가 정말 중요한데요"
  },
  {
   "t0": 317.52,
   "t1": 321.72,
   "text": "'언제 가입했느냐'가 전부라고 해도 틀린 말이 아닙니다"
  },
  {
   "t0": 321.72,
   "t1": 326.86,
   "text": "암보험은 2011년 4월 이전에 가입했느냐가 중요합니다"
  },
  {
   "t0": 326.86,
   "t1": 328.66,
   "text": "분쟁의 여지 때문인데요"
  },
  {
   "t0": 328.66,
   "t1": 331.76,
   "text": "이때 가입한 암보험이 지금보다 좋았던 건"
  },
  {
   "t0": 331.76,
   "t1": 335.8,
   "text": "전이암까지 함께 보상받는 경우가 있었기 때문입니다"
  },
  {
   "t0": 335.8,
   "t1": 338.0,
   "text": "약관을 해석하는 데 있어서"
  },
  {
   "t0": 338.0,
   "t1": 340.84,
   "text": "소비자에게 유리한 문구가 많았거든요"
  },
  {
   "t0": 340.84,
   "t1": 344.44,
   "text": "예를 들어 최초의 갑상선암이 발생했고"
  },
  {
   "t0": 344.44,
   "t1": 348.38,
   "text": "목 주변 림프절로 전이되었다고 가정해 보겠습니다"
  },
  {
   "t0": 348.38,
   "t1": 351.12,
   "text": "과거 일부 약관에는 이럴 때"
  },
  {
   "t0": 351.12,
   "t1": 355.32,
   "text": "보험금을 처음 발생한 갑상선암을 기준으로 보상할지"
  },
  {
   "t0": 355.32,
   "t1": 359.36,
   "text": "아니면 전이 된 림프절까지 인정해서 보상할지"
  },
  {
   "t0": 359.36,
   "t1": 361.96,
   "text": "그 기준이 명확하지가 않았습니다"
  },
  {
   "t0": 361.96,
   "t1": 365.6,
   "text": "보험사 입장에서는 갑상선만 보상하면"
  },
  {
   "t0": 365.6,
   "t1": 368.6,
   "text": "적은 금액을 보상해 주고 끝내버릴 수 있는데"
  },
  {
   "t0": 368.6,
   "t1": 371.4,
   "text": "림프절 전이암까지 보상하게 되면"
  },
  {
   "t0": 371.4,
   "t1": 374.21,
   "text": "림프절은 일반암으로 보상해야 하기 때문에"
  },
  {
   "t0": 374.21,
   "t1": 375.94,
   "text": "큰 금액을 지급해야 하니까"
  },
  {
   "t0": 375.94,
   "t1": 378.04,
   "text": "가입자와 분쟁이 있었던 거죠"
  },
  {
   "t0": 378.04,
   "t1": 382.62,
   "text": "그런데 당시에는 약관상 문구가 명확하지가 않아서요"
  },
  {
   "t0": 382.62,
   "t1": 386.19,
   "text": "실제 판례에서도 약관 문구가 명확하지 않다면"
  },
  {
   "t0": 386.19,
   "t1": 389.12,
   "text": "소비자에게 유리하게 해야 한다고 보고"
  },
  {
   "t0": 389.12,
   "t1": 391.69,
   "text": "소비자의 손을 들어준 적이 있었습니다"
  },
  {
   "t0": 391.69,
   "t1": 394.76,
   "text": "하지만 2011년 4월 1일 이후에"
  },
  {
   "t0": 394.76,
   "t1": 396.66,
   "text": "이 부분이 정리가 되면서"
  },
  {
   "t0": 396.66,
   "t1": 400.9,
   "text": "이제는 원발 부위가 확인되면 원발 부위를 기준으로"
  },
  {
   "t0": 400.9,
   "t1": 404.2,
   "text": "지급해야 한다는 문구가 약관에 들어가기 시작하면서"
  },
  {
   "t0": 404.2,
   "t1": 406.91,
   "text": "현재의 암 보험의 형태가 되었던 겁니다"
  },
  {
   "t0": 406.91,
   "t1": 407.84,
   "text": "그렇기 때문에"
  },
  {
   "t0": 407.84,
   "t1": 411.24,
   "text": "2011년 4월 이전에 암 보험이라면"
  },
  {
   "t0": 411.24,
   "t1": 413.38,
   "text": "해지하지 않는 게 유리하겠습니다"
  },
  {
   "t0": 413.38,
   "t1": 416.22,
   "text": "보험을 하면서 자주 생각하는 게 있는데요"
  },
  {
   "t0": 416.22,
   "t1": 420.59,
   "text": "삶이 팍팍해서 보험을 정리하는 건 이해가 되는데요"
  },
  {
   "t0": 420.59,
   "t1": 424.06,
   "text": "그렇다고 보험료만 보고 정리하지는 마시고요"
  },
  {
   "t0": 424.06,
   "t1": 428.33,
   "text": "내가 포기하게 되는 권리가 무엇인지도 잘 알고서"
  },
  {
   "t0": 428.33,
   "t1": 430.06,
   "text": "결정해야 한다는 점입니다"
  },
  {
   "t0": 430.06,
   "t1": 434.03,
   "text": "보험은 불필요해 보인다고 없애버리는 게 아니라"
  },
  {
   "t0": 434.03,
   "t1": 437.6,
   "text": "대체 가능한 대안이 있는지도 꼼꼼히 확인하고"
  },
  {
   "t0": 437.6,
   "t1": 439.14,
   "text": "바꾸셔야 되겠습니다"
  },
  {
   "t0": 439.14,
   "t1": 443.24,
   "text": "내 보험에 여성보험이나 1-3종 보험 등이 있다면?"
  },
  {
   "t0": 443.24,
   "t1": 444.84,
   "text": "댓글로 자랑해 주시고요"
  },
  {
   "t0": 444.84,
   "t1": 446.48,
   "text": "보험 점검이 필요하다면"
  },
  {
   "t0": 446.48,
   "t1": 448.58,
   "text": "아래 링크를 눌러 문의 주시면"
  },
  {
   "t0": 448.58,
   "t1": 450.58,
   "text": "성심성의껏 도와드리겠습니다"
  },
  {
   "t0": 450.58,
   "t1": 453.65,
   "text": "내용이 도움 되셨다면 가족이나 지인에게"
  },
  {
   "t0": 453.65,
   "t1": 455.32,
   "text": "영상 공유 꼭 해주시고요"
  },
  {
   "t0": 455.32,
   "t1": 457.99,
   "text": "저는 다음 영상에서 찾아뵙겠습니다"
  },
  {
   "t0": 457.99,
   "t1": 458.76,
   "text": "감사합니다"
  }
